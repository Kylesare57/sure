# Copy to .env on the Pi:  cp env.template .env
# Then fill in the values below. Never commit or share this file.

# --- Required ---
# Generate with:  openssl rand -hex 64
SECRET_KEY_BASE=
# Any long random string, e.g.:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Access ---
# Change if port 3000 is already used on the Pi
PORT=3000
# Your Pi's Tailscale HTTPS name once set up, e.g. homeserver.tail1234.ts.net
APP_DOMAIN=
# Set to true after you start using Tailscale HTTPS
RAILS_ASSUME_SSL=false
# Switch to "closed" after creating your account
ONBOARDING_STATE=open

# --- Plaid ---
# Sandbox keys from the Plaid dashboard (Home > Getting started) for testing now.
# When the Trial is approved: paste the PRODUCTION secret and set PLAID_ENV=production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
